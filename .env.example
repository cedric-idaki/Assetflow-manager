# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Anything prefixed VITE_ is inlined into the client bundle and is public by
# definition. Server-side secrets belong in Supabase Edge Function secrets
# (`supabase secrets set NAME=value`), not here.

# ── Supabase (public) ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Stripe (publishable key only — never the secret key) ──────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# ── Analytics (optional) ──────────────────────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_ID=

# ── AWS Lambda endpoints (optional) ───────────────────────────────────────────
VITE_AWS_LAMBDA_CHAT_COMPLETION_URL=
VITE_AWS_LAMBDA_IMAGE_EDIT_URL=
VITE_AWS_LAMBDA_IMAGE_GENERATION_URL=

# ══════════════════════════════════════════════════════════════════════════════
# The values below are NOT read by the frontend. They are listed so the required
# set is documented in one place; set them as Edge Function secrets:
#
#   supabase secrets set RESEND_API_KEY=... TWILIO_AUTH_TOKEN=...
#
#   RESEND_API_KEY          transactional email
#   EMAIL_FROM              verified sender address
#   TWILIO_ACCOUNT_SID      SMS
#   TWILIO_AUTH_TOKEN
#   TWILIO_PHONE_NUMBER
#   PORTAL_URL              canonical portal origin for signing links
#   ESIGN_ALLOWED_PORTALS   extra approved portal origins, comma-separated
#   CRON_SECRET             shared secret for the scheduled workers
# ══════════════════════════════════════════════════════════════════════════════
